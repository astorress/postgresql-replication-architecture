{
  "name": "postgresql-replication",
  "dockerComposeFile": [".docker/docker-compose.yml", ".docker/replication.yml"],
  "service": "postgresql_lab",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "eeyore.yapf",
        "irongeek.vscode-env",
        "ms-azuretools.vscode-docker",
        "ms-ossdata.vscode-pgsql",
        "ms-python.isort",
        "ms-python.pylint",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "pylint.interpreter": ["/usr/local/bin/python"],
        "yapf.interpreter": ["/usr/local/bin/python"],
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          },
          "editor.defaultFormatter": "eeyore.yapf"
        }
      }
    }
  },
  "postCreateCommand": "chmod +x .docker/entrypoint.sh && .docker/entrypoint.sh"
}
