<mxfile pages="1"><diagram id="replication-page" name="Streaming replication"><mxGraphModel grid="0" page="1" background="#ffffff"><root><mxCell id="replication-0" /><mxCell id="replication-bg" parent="replication-0" value="background" /><mxCell id="replication-bgr" parent="replication-bg" style="whiteSpace=wrap;html=1;strokeColor=none;" value="" vertex="1"><mxGeometry width="2060" height="860" as="geometry" /></mxCell><mxCell id="replication-common" parent="replication-0" value="replication-common" /><mxCell id="replication-1" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2496ED;dashed=0;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#2496ED;fontFamily=Verdana;container=0;collapsible=0;" value="Docker Compose · proyecto &lt;b&gt;postgresql-replication&lt;/b&gt; · red interna (cada servicio se resuelve por su nombre)" vertex="1"><mxGeometry x="160" y="40" width="1100" height="780" as="geometry" /></mxCell><mxCell id="replication-2" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="166" y="44" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-3" parent="replication-common" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;fontFamily=Verdana;" value="Desarrollador" vertex="1"><mxGeometry x="40" y="379" width="60" height="60" as="geometry" /></mxCell><mxCell id="replication-4" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="95" y="349" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-5" parent="replication-common" style="shape=mxgraph.veeam2.laptop;html=1;fillColor=#CCCCCC;strokeColor=none;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=top;verticalAlign=bottom;align=center;" value="Host&lt;br&gt;localhost:5441-5443&lt;br&gt;pgAdmin · DBeaver · psql" vertex="1"><mxGeometry x="30" y="640" width="100" height="60" as="geometry" /></mxCell><mxCell id="replication-6" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt;" vertex="1"><mxGeometry x="135" y="690" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-7" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Container &lt;b&gt;PgReplicaLab&lt;/b&gt;&lt;br&gt;Python 3.13 · JupyterLab :8889" vertex="1"><mxGeometry x="190" y="300" width="240" height="230" as="geometry" /></mxCell><mxCell id="replication-8" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="196" y="304" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-9" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;fontSize=11;" value="lessons/00-07&lt;br&gt;psycopg 3 · psql 18" vertex="1"><mxGeometry x="275" y="374" width="70" height="70" as="geometry" /></mxCell><mxCell id="replication-10" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;" vertex="1"><mxGeometry x="343" y="330" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-11" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="377" y="330" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-12" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Container &lt;b&gt;PgNode1&lt;/b&gt; · pg1&lt;br&gt;postgres:18.4 · :5441" vertex="1"><mxGeometry x="500" y="300" width="300" height="300" as="geometry" /></mxCell><mxCell id="replication-13" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="506" y="304" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-14" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;fontSize=11;" value="&lt;b&gt;pg1&lt;/b&gt; · PRIMARY&lt;br&gt;lecturas y escrituras" vertex="1"><mxGeometry x="614" y="373" width="72" height="72" as="geometry" /></mxCell><mxCell id="replication-15" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="684" y="343" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-16" parent="replication-common" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="pg1-data" vertex="1"><mxGeometry x="710" y="495" width="60" height="72" as="geometry" /></mxCell><mxCell id="replication-17" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;" vertex="1"><mxGeometry x="770" y="465" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-18" parent="replication-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=34;spacingTop=-2;fontSize=12;fontColor=#232F3E;fontFamily=Verdana;container=0;collapsible=0;" value="Container &lt;b&gt;PgNode2&lt;/b&gt; · pg2&lt;br&gt;postgres:18.4 · :5442" vertex="1"><mxGeometry x="920" y="120" width="300" height="260" as="geometry" /></mxCell><mxCell id="replication-19" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="926" y="124" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-20" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;fontSize=11;" value="&lt;b&gt;pg2&lt;/b&