tml=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;" value="" vertex="1"><mxGeometry x="926" y="524" width="24" height="24" as="geometry" /></mxCell><mxCell id="replication-27" parent="replication-common" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;image=data:image/svg+xml,;fontSize=11;" value="&lt;b&gt;pg3&lt;/b&gt; · STANDBY&lt;br&gt;hot standby (solo lectura)" vertex="1"><mxGeometry x="960" y="580" width="72" height="72" as="geometry" /></mxCell><mxCell id="replication-28" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;" vertex="1"><mxGeometry x="1030" y="550" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-29" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="1032" y="596" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-30" parent="replication-common" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#E6E6E6;strokeColor=#666666;fontFamily=Verdana;fontSize=12;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;whiteSpace=nowrap;" value="pg3-data" vertex="1"><mxGeometry x="1130" y="580" width="60" height="72" as="geometry" /></mxCell><mxCell id="replication-31" parent="replication-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;" vertex="1"><mxGeometry x="1190" y="550" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-usage" parent="replication-0" value="replication-usage" /><mxCell id="replication-32" edge="1" parent="replication-usage" source="replication-3" target="replication-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="replication-33" edge="1" parent="replication-usage" source="replication-9" target="replication-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="replication-34" edge="1" parent="replication-usage" source="replication-14" target="replication-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="395" /><mxPoint x="860" y="205" /></Array></mxGeometry></mxCell><mxCell id="replication-35" edge="1" parent="replication-usage" source="replication-14" target="replication-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="423" /><mxPoint x="880" y="605" /></Array></mxGeometry></mxCell><mxCell id="replication-36" edge="1" parent="replication-usage" source="replication-5" target="replication-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="670" /></Array></mxGeometry></mxCell><mxCell id="replication-37" edge="1" parent="replication-usage" source="replication-5" target="replication-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="795" /><mxPoint x="880" y="795" /><mxPoint x="880" y="616" /></Array></mxGeometry></mxCell><mxCell id="replication-38" edge="1" parent="replication-usage" source="replication-5" target="replication-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="810" /><mxPoint x="900" y="810" /><mxPoint x="900" y="216" /></Array></mxGeometry></mxCell><mxCell id="replication-39" edge="1" parent="replication-usage" source="replication-9" target="replication-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.15;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="385" /><mxPoint x="450" y="191" /></Array></mxGeometry></mxCell><mxCell id="replication-40" edge="1" parent="replication-usage" source="replication-7" target="replication-27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;jumpStyle=arc;jumpSize=10;exitX=0.8;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="382" y="720" /><mxPoint x="900" y="720" /><mxPoint x="900" y="638" /></Array></mxGeometry></mxCell><mxCell id="replication-bootstrap" parent="replication-0" value="replication-bootstrap" /><mxCell id="replication-41" parent="replication-bootstrap" style="sketch=0;html=1;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.gear;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;" value="initdb/10-replication.sh" vertex="1"><mxGeometry x="562" y="510" width="47" height="47" as="geometry" /></mxCell><mxCell id="replication-42" parent="replication-bootstrap" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="602" y="480" width="48" height="52" as="geometry" /></mxCell><mxCell id="replication-43" edge="1" parent="replication-bootstrap" source="replication-41" target="replication-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="431" /></Array></mxGeometry></mxCell><mxCell id="replication-info" parent="replication-0" value="replication-info" /><mxCell id="replication-44" parent="replication-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Replicación por streaming&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Tres nodos de PostgreSQL 18 con la misma copia de los datos, cada uno en su contenedor y con su propio volumen: un &lt;b&gt;primary&lt;/b&gt; que acepta escrituras y dos &lt;b&gt;standby&lt;/b&gt; de solo lectura que reciben su WAL en tiempo real. A diferencia de un replica set de MongoDB, PostgreSQL no elige un nuevo primary por sí solo: el failover es manual.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Arranque&lt;/b&gt; (azul). Al crear &lt;b&gt;pg1&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;, el entrypoint oficial ejecuta initdb y luego &lt;b&gt;initdb/10-replication.sh&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;: crea el rol de replicación, un slot por standby y la regla de pg_hba. Cuando pg1 responde, &lt;b&gt;pg2&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt; y &lt;b&gt;pg3&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt; encuentran su directorio de datos vacío y se inicializan con pg_basebackup (flechas azules); escriben standby.signal y primary_conninfo, y arrancan como standby. Cada nodo conserva sus datos en un volumen persistente propio. &lt;b&gt;PgReplicaLab&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt; espera a que algún nodo acepte escrituras. Si un nodo ya tiene datos, arranca con el rol que tenía.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Uso&lt;/b&gt;. El &lt;b&gt;desarrollador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; ejecuta las lecciones en &lt;b&gt;PgReplicaLab&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;. La aplicación recibe los tres nodos (PGHOST=pg1,pg2,pg3) y pide uno que acepte escrituras (target_session_attrs=read-write): libpq los prueba en orden y se queda con el primary, &lt;b&gt;pg1&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;. Algunas lecciones también se conectan directo a &lt;b&gt;pg2&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; y &lt;b&gt;pg3&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; para leer de un standby (flechas punteadas desde el laboratorio).&lt;/p&gt;&lt;p&gt;&lt;b&gt;Replicación&lt;/b&gt; (flechas punteadas desde pg1). Cada cambio queda primero en el WAL de &lt;b&gt;pg1-data&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;. Por cada standby, un proceso walsender en pg1 le envía el WAL en cuanto se genera; el walreceiver del standby lo aplica en &lt;b&gt;pg2-data&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; y &lt;b&gt;pg3-data&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;. Es replicación física: cada standby es una copia idéntica de todo el primary. El slot de cada standby hace que pg1 guarde el WAL que aún no ha recibido, así un standby caído se pone al día al volver.&lt;/p&gt;&lt;p&gt;Desde el &lt;b&gt;host&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt;, cada nodo se publica en su propio puerto (5441, 5442 y 5443) para abrirlo con un cliente gráfico; un UPDATE en un standby falla porque es de solo lectura.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Failover&lt;/b&gt; (lección 06). Se aísla el primary, se espera a que un standby aplique todo su WAL, se promueve con pg_promote() (empieza el timeline 2) y se apunta el otro standby al nuevo primary. libpq encuentra al nuevo primary al reconectar. El primary antiguo se reincorpora como standby con replication/rejoin.sh (pg_rewind, o pg_basebackup si no puede).&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1300" y="40" width="720" height="510" as="geometry" /></mxCell><mxCell id="replication-45" parent="replication-bootstrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="replication-14" target="replication-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="391" /><mxPoint x="900" y="234" /></Array></mxGeometry></mxCell><mxCell id="replication-46" parent="replication-bootstrap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="replication-14" target="replication-27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="438" /><mxPoint x="900" y="594" /></Array></mxGeometry></mxCell><mxCell id="replication-47" parent="replication-common" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;endArrow=none;startArrow=none;exitX=1;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="replication-14" target="replication-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="445" /></Array></mxGeometry></mxCell><mxCell id="replication-48" parent="replication-common" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="replication-20" target="replication-23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="replication-49" parent="replication-common" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" source="replication-27" target="replication-30"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>