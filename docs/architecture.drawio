<mxfile pages="1"><diagram id="replication" name="Streaming replication"><mxGraphModel grid="0" page="1" pageWidth="1380" pageHeight="740" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" parent="1" vertex="1" value="Docker Compose · proyecto &lt;b&gt;postgresql-replication&lt;/b&gt; · red interna (cada servicio se resuelve por su nombre)" style="fontFamily=Verdana;rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;strokeColor=#2496ED;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#2496ED;fontSize=13;"><mxGeometry x="20" y="20" width="1120" height="700" as="geometry"/></mxCell><mxCell id="c2" parent="1" vertex="1" value="&lt;b&gt;PgReplicaLab&lt;/b&gt; (postgresql_lab)&lt;br&gt;Python 3.13 · psycopg 3 · psql 18&lt;br&gt;&lt;font style='font-size:11px'&gt;PGHOST=pg1,pg2,pg3 · target_session_attrs=read-write&lt;br&gt;lessons/00-07&lt;/font&gt;" style="fontFamily=Verdana;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;"><mxGeometry x="380" y="70" width="400" height="110" as="geometry"/></mxCell><mxCell id="c3" parent="1" vertex="1" value="&lt;b&gt;PgNode1 · pg1&lt;/b&gt;&lt;br&gt;PRIMARY (lectura y escritura)&lt;br&gt;&lt;font style='font-size:11px'&gt;postgres:18.4 · wal_level=logical&lt;br&gt;walsender × 2 · slots pg2_slot, pg3_slot&lt;/font&gt;" style="fontFamily=Verdana;rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#336791;strokeWidth=2;fontSize=12;"><mxGeometry x="420" y="290" width="320" height="120" as="geometry"/></mxCell><mxCell id="c4" parent="1" vertex="1" value="&lt;b&gt;PgNode2 · pg2&lt;/b&gt;&lt;br&gt;STANDBY (hot standby, solo lectura)&lt;br&gt;&lt;font style='font-size:11px'&gt;standby.signal · walreceiver&lt;br&gt;primary_conninfo host=pg1&lt;/font&gt;" style="fontFamily=Verdana;rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#336791;fontSize=12;"><mxGeometry x="100" y="520" width="320" height="110" as="geometry"/>