te)" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#D6B656;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" parent="1" edge="1" source="c3" target="c4" value="WAL por streaming&lt;br&gt;(replicación física)" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#336791;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" parent="1" edge="1" source="c3" target="c5" value="WAL por streaming&lt;br&gt;(replicación física)" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#336791;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" parent="1" edge="1" source="c2" target="c4" value="lecturas desde standby&lt;br&gt;target_session_attrs=standby" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#999999;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="125"/></Array></mxGeometry></mxCell><mxCell id="c16" parent="1" edge="1" source="c2" target="c5" value="lecturas desde standby" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#999999;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="125"/></Array></mxGeometry></mxCell><mxCell id="c17" parent="1" vertex="1" value="&lt;b&gt;Host&lt;/b&gt;&lt;br&gt;localhost:5441 → pg1&lt;br&gt;localhost:5442 → pg2&lt;br&gt;localhost:5443 → pg3" style="fontFamily=Verdana;rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;"><mxGeometry x="1170" y="290" width="170" height="120" as="geometry"/></mxCell><mxCell id="c18" parent="1" edge="1" source="c17" target="c3" value="puertos publicados" style="fontFamily=Verdana;endArrow=block;html=1;strokeColor=#82B366;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" parent="1" vertex="1" value="&lt;b&gt;Arranque&lt;/b&gt; (replication/node.sh)&lt;br&gt;1. pg1: initdb + initdb/10-replication.sh&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(rol replicator, slots, pg_hba)&lt;br&gt;2. pg2, pg3: pg_basebackup desde pg1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ standby.signal + primary_conninfo&lt;br&gt;3. Lab: entrypoint.sh espera un PRIMARY&lt;br&gt;&lt;br&gt;&lt;b&gt;Failover manual&lt;/b&gt; (lección 06)&lt;br&gt;fencing → pg_promote() → repuntar standby&lt;br&gt;&lt;b&gt;Reincorporar&lt;/b&gt;: replication/rejoin.sh (pg_rewind)" style="fontFamily=Verdana;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;"><mxGeometry x="440" y="500" width="290" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
